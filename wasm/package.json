{
  "name": "md4c-wasm",
  "version": "0.6.0",
  "private": true,
  "description": "MD4C compiled to WebAssembly, a storagesdk-backed file system, and a demo blog with an admin-only editor.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:wasm": "sh build.sh",
    "build": "sh build.sh && node scripts/assemble-blog.mjs",
    "start": "node server/server.mjs",
    "set-password": "node scripts/set-admin-password.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@storagesdk/adapters": "^0.12.0",
    "@storagesdk/core": "^0.5.0",
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
