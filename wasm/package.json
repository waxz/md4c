    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@storagesdk/core": "^0.5.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
