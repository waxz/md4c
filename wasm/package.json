{
  "name": "md4c-wasm",
  "version": "0.6.0",
  "private": true,
  "description": "MD4C compiled to WebAssembly, a storagesdk file system, a static blog published to R2, and an admin Worker for editing from any device.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:wasm": "sh build.sh",
    "build": "sh build.sh && node scripts/assemble-blog.mjs",
    "deploy": "node scripts/publish.mjs --site",
    "test": "node --test test/*.test.mjs",
    "admin:dev": "node admin/dev/server.mjs",
    "admin:deploy": "npx wrangler deploy --config admin/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@octokit/rest": "^21.1.1",
    "@storagesdk/adapters": "^0.12.0",
    "@storagesdk/core": "^0.5.0",
    "dompurify": "^3.4.17",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "pdfjs-dist": "^6.4.299",
    "webdav": "^5.11.0"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/lib-storage": "^3.1151.0",
    "@aws-sdk/s3-presigned-post": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0"
  },
  "devDependencies": {
    "webdav-server": "^2.6.3"
  }
}
