{
  "name": "md4c-wasm",
  "version": "0.6.0",
  "private": true,
  "description": "MD4C compiled to WebAssembly, a storagesdk file system for the browser, and a read-only blog published to R2 or any storagesdk backend.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:wasm": "sh build.sh",
    "build": "sh build.sh && node scripts/assemble-blog.mjs",
    "deploy": "node scripts/publish.mjs --site",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@storagesdk/adapters": "^0.12.0",
    "@storagesdk/core": "^0.5.0",
    "dompurify": "^3.4.17"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/lib-storage": "^3.1151.0",
    "@aws-sdk/s3-presigned-post": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0"
  }
}
