{
  "name": "md4c-wasm",
  "version": "0.6.0",
  "private": true,
  "description": "MD4C compiled to WebAssembly, a storagesdk-backed browser file system, and a demo blog.",
  "type": "module",
  "license": "MIT",
  "scripts": {
